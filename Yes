#include <iostream>
#include <cstdlib>
#include <ctime>

#ifdef _WIN32
#include <windows.h>
#endif

using namespace std;

const int N = 10;
const char* COL[N] = {"А", "Б", "В", "Г", "Ґ", "Д", "Е", "Є", "Ж", "З"};
const char* UKR_UPPER[N] = {"А", "Б", "В", "Г", "Ґ", "Д", "Е", "Є", "Ж", "З"};
const char* UKR_LOWER[N] = {"а", "б", "в", "г", "ґ", "д", "е", "є", "ж", "з"};

struct Board {
    char grid[N][N];
    int ships = 0;

    Board() {
        for (int i = 0; i < N; i++)
            for (int j = 0; j < N; j++)
                grid[i][j] = '.';
    }

    bool canPlace(int r, int c, int sz, int dir) {
        if (dir == 0 && c + sz > N) return false;
        if (dir == 1 && r + sz > N) return false;
        int rEnd = (dir == 1) ? r + sz : r + 1;
        int cEnd = (dir == 0) ? c + sz : c + 1;
        for (int i = r - 1; i <= rEnd; i++)
            for (int j = c - 1; j <= cEnd; j++)
                if (i >= 0 && i < N && j >= 0 && j < N && grid[i][j] != '.')
                    return false;
        return true;
    }

    void autoPlace() {
        int sizes[] = {4, 3, 3, 2, 2, 2, 1, 1, 1, 1};
        for (int sz : sizes) {
            while (true) {
                int r = rand() % N, c = rand() % N, dir = rand() % 2;
                if (canPlace(r, c, sz, dir)) {
                    for (int i = 0; i < sz; i++) {
                        grid[r + (dir ? i : 0)][c + (dir ? 0 : i)] = 'S';
                        ships++;
                    }
                    break;
                }
            }
        }
    }

    int shoot(int r, int c) {
        if (grid[r][c] == 'S') { grid[r][c] = 'X'; ships--; return 1; }
        if (grid[r][c] == '.') { grid[r][c] = '*'; return 0; }
        return -1;
    }

    void print(bool hide) {
        cout << "  ";
        for (int j = 0; j < N; j++) cout << COL[j] << " ";
        cout << "\n";
        for (int i = 0; i < N; i++) {
            if (i < 9) cout << " ";
            cout << i + 1 << " ";
            for (int j = 0; j < N; j++)
                cout << (hide && grid[i][j] == 'S' ? '.' : grid[i][j]) << " ";
            cout << "\n";
        }
    }
};

bool parseCoord(const char* s, int& r, int& c) {
    int offset = 0;
    c = -1;

    if (s[0] >= 'A' && s[0] <= 'J') { c = s[0] - 'A'; offset = 1; }
    else if (s[0] >= 'a' && s[0] <= 'j') { c = s[0] - 'a'; offset = 1; }
    else {
        for (int i = 0; i < N; i++) {
            if ((s[0] == UKR_UPPER[i][0] && s[1] == UKR_UPPER[i][1]) ||
                (s[0] == UKR_LOWER[i][0] && s[1] == UKR_LOWER[i][1])) {
                c = i;
                offset = 2;
                break;
            }
        }
    }

    if (c == -1 || s[offset] == '\0') return false;

    r = 0;
    for (int i = offset; s[i] >= '0' && s[i] <= '9'; i++)
        r = r * 10 + (s[i] - '0');
    r--;

    return (r >= 0 && r < N);
}

void aiTurn(Board& b) {
    while (true) {
        int r = rand() % N, c = rand() % N;
        int res = b.shoot(r, c);
        if (res != -1) {
            cout << "Комп'ютер стріляє в " << COL[c] << r + 1 << " - "
                 << (res == 1 ? "ВЛУЧАННЯ!\n" : "ПРОМАХ!\n");
            break;
        }
    }
}

int main() {
#ifdef _WIN32
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
#endif
    srand(time(0));

    while (true) {
        cout << "=== МОРСЬКИЙ БІЙ ===\n";
        cout << "1. Гравець проти Комп'ютера\n";
        cout << "2. Комп'ютер проти Комп'ютера\n";
        cout << "0. Вихід\nВибір: ";
        int mode;
        if (!(cin >> mode) || mode == 0) break;

        bool isCvC = (mode == 2);
        Board p1, p2;
        p1.autoPlace();
        p2.autoPlace();

        bool p1Turn = true;
        while (p1.ships > 0 && p2.ships > 0) {
            cout << "\n----------------------------------\n";
            if (!isCvC) {
                cout << "ВАШЕ ПОЛЕ:\n"; p1.print(false);
                cout << "\nПОЛЕ КОМП'ЮТЕРА:\n"; p2.print(true);
            } else {
                cout << "КОМП'ЮТЕР 1:\n"; p1.print(false);
                cout << "\nКОМП'ЮТЕР 2:\n"; p2.print(false);
            }

            if (p1Turn) {
                if (isCvC) {
                    cout << "\nХід Комп'ютера 1...\n";
                    aiTurn(p2);
                } else {
                    cout << "\nВаш хід (напр. Б5 або B5): ";
                    char input[20];
                    cin >> input;
                    int r, c;
                    if (parseCoord(input, r, c)) {
                        int res = p2.shoot(r, c);
                        if (res == -1) {
                            cout << "Сюди вже стріляли!\n";
                            continue;
                        }
                        cout << (res == 1 ? ">>> ВЛУЧАННЯ!\n" : ">>> ПРОМАХ.\n");
                    } else {
                        cout << "Некоректні координати!\n";
                        continue;
                    }
                }
            } else {
                cout << "\nХід Комп'ютера...\n";
                aiTurn(p1);
            }
            p1Turn = !p1Turn;
        }

        if (p1.ships == 0) cout << "\nПЕРЕМІГ КОМП'ЮТЕР " << (isCvC ? "2" : "") << "!\n\n";
        else cout << "\nВИ ПЕРЕМОГЛИ!\n\n";
    }
    return 0;
}
