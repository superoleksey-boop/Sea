using namespace std;

const int BOARD_SIZE = 10;
const char WATER = '.';
const char SHIP = 'S';
const char HIT = 'X';
const char MISS = '*';

const char* COL_NAMES[BOARD_SIZE] = {"А", "Б", "В", "Г", "Д", "Е", "Ж", "З", "И", "К"};

unsigned int g_seed = 12345;
void mySrand(unsigned int seed) {
    g_seed = seed;
}
int myRand() {
    g_seed = g_seed * 1103515245 + 12345;
    return (int)((g_seed / 65536) % 32768);
}

char myToupper(char c) {
    if (c >= 'a' && c <= 'z') return c - 'a' + 'A';
    return c;
}

struct Point {
    int r, c;
};

struct PointStack {
    Point data[100];
    int count = 0;

    void push(Point p) {
        if (count < 100) data[count++] = p;
    }
    Point pop() {
        return data[--count];
    }
    bool empty() const {
        return count == 0;
    }
    void clear() {
        count = 0;
    }
};

class Board {
public:
    char grid[BOARD_SIZE][BOARD_SIZE];
    int shipsAlive;

    Board() {
        for (int i = 0; i < BOARD_SIZE; ++i)
            for (int j = 0; j < BOARD_SIZE; ++j)
                grid[i][j] = WATER;
        shipsAlive = 0;
    }

    bool canPlace(int r, int c, int size, int dir) {
        if (dir == 0) {
            if (c + size > BOARD_SIZE) return false;
            for (int i = r - 1; i <= r + 1; ++i)
                for (int j = c - 1; j <= c + size; ++j)
                    if (i >= 0 && i < BOARD_SIZE && j >= 0 && j < BOARD_SIZE)
                        if (grid[i][j] != WATER) return false;
        } else {
            if (r + size > BOARD_SIZE) return false;
            for (int i = r - 1; i <= r + size; ++i)
                for (int j = c - 1; j <= c + 1; ++j)
                    if (i >= 0 && i < BOARD_SIZE && j >= 0 && j < BOARD_SIZE)
                        if (grid[i][j] != WATER) return false;
        }
        return true;
    }

    void place(int r, int c, int size, int dir) {
        for (int i = 0; i < size; ++i) {
            if (dir == 0) grid[r][c + i] = SHIP;
            else grid[r + i][c] = SHIP;
            shipsAlive++;
        }
    }

    void autoPlace() {
        int ships[10] = {4, 3, 3, 2, 2, 2, 1, 1, 1, 1};
        for (int k = 0; k < 10; ++k) {
            int size = ships[k];
            bool placed = false;
            while (!placed) {
                int r = myRand() % BOARD_SIZE;
                int c = myRand() % BOARD_SIZE;
                int dir = myRand() % 2;
                if (canPlace(r, c, size, dir)) {
                    place(r, c, size, dir);
                    placed = true;
                }
            }
        }
    }

    static bool parseCoord(const char* buf, int& r, int& c) {
        int i = 0;
        c = -1;

        if ((buf[0] >= 'A' && buf[0] <= 'J') || (buf[0] >= 'a' && buf[0] <= 'j')) {
            c = myToupper(buf[0]) - 'A';
            i = 1;
        } else if ((unsigned char)buf[0] == 0xD0 || (unsigned char)buf[0] == 0xD1) {
            unsigned char c2 = (unsigned char)buf[1];
            if (c2 == 0x90 || c2 == 0xB0) c = 0;
            else if (c2 == 0x91 || c2 == 0xB1) c = 1;
            else if (c2 == 0x92 || c2 == 0xB2) c = 2;
            else if (c2 == 0x93 || c2 == 0xB3) c = 3;
            else if (c2 == 0x94 || c2 == 0xB4) c = 4;
            else if (c2 == 0x95 || c2 == 0xB5) c = 5;
            else if (c2 == 0x96 || c2 == 0xB6) c = 6;
            else if (c2 == 0x97 || c2 == 0xB7) c = 7;
            else if (c2 == 0x98 || c2 == 0xB8) c = 8;
            else if (c2 == 0x9A || c2 == 0xBA) c = 9;
            if (c != -1) i = 2;
        } else if ((unsigned char)buf[0] >= 0xC0 && (unsigned char)buf[0] <= 0xFF) {
            unsigned char uc = (unsigned char)buf[0];
            if (uc >= 0xC0 && uc <= 0xC7) c = uc - 0xC0;
            else if (uc == 0xC8) c = 8;
            else if (uc == 0xC9) c = 9;
            else if (uc >= 0xE0 && uc <= 0xE7) c = uc - 0xE0;
            else if (uc == 0xE8) c = 8;
            else if (uc == 0xE9) c = 9;
            if (c != -1) i = 1;
        }

        if (c < 0 || c >= BOARD_SIZE) return false;

        r = 0;
        if (buf[i] == '\0') return false;
        while (buf[i] >= '0' && buf[i] <= '9') {
            r = r * 10 + (buf[i] - '0');
            i++;
        }
        r--;
        return (r >= 0 && r < BOARD_SIZE);
    }

    void manualPlace() {
        int ships[10] = {4, 3, 3, 2, 2, 2, 1, 1, 1, 1};
        for (int k = 0; k < 10; ++k) {
            int size = ships[k];
            bool placed = false;
            while (!placed) {
                print(false);
                cout << "Розмістіть корабель на " << size << " палуб.\n";
                cout << "Введіть координати та напрямок (наприклад, А5 0 для горизонталі, Б2 1 для вертикалі): ";
                char input[20];
                int dir;
                cin >> input >> dir;

                int r, c;
                if (parseCoord(input, r, c) && (dir == 0 || dir == 1) && canPlace(r, c, size, dir)) {
                    place(r, c, size, dir);
                    placed = true;
                } else {
                    cout << "Помилка! Неправильні координати або кораблі перетинаються. Спробуйте ще.\n";
                }
            }
        }
    }

    int receiveShot(int r, int c) {
        if (grid[r][c] == SHIP) {
            grid[r][c] = HIT;
            shipsAlive--;
            return 1;
        } else if (grid[r][c] == WATER) {
            grid[r][c] = MISS;
            return 0;
        }
        return -1;
    }

    void print(bool hidden) {
        cout << "  А Б В Г Д Е Ж З И К\n";
        for (int i = 0; i < BOARD_SIZE; ++i) {
            if (i < 9) cout << " ";
            cout << i + 1 << " ";
            for (int j = 0; j < BOARD_SIZE; ++j) {
                if (hidden && grid[i][j] == SHIP) {
                    cout << WATER << " ";
                } else {
                    cout << grid[i][j] << " ";
                }
            }
            cout << "\n";
        }
    }
};

class Game {
private:
    Board player1, player2;
    bool isCvC;
    bool smartAI;
    PointStack aiTargetStack;

    int handleMenu() {
        cout << "\n--- ПАУЗА / МЕНЮ ---\n";
        cout << "1. Продовжити гру\n";
        cout << "2. Почати нову гру (Рестарт)\n";
        cout << "3. Вийти з гри\n";
        cout << "Вибір: ";
        int choice;
        cin >> choice;
        return choice;
    }

    void aiTurn(Board& targetBoard) {
        bool validShot = false;
        while (!validShot) {
            int r, c;
            if (smartAI && !aiTargetStack.empty()) {
                Point p = aiTargetStack.pop();
                r = p.r;
                c = p.c;
            } else {
                r = myRand() % BOARD_SIZE;
                c = myRand() % BOARD_SIZE;
            }

            int result = targetBoard.receiveShot(r, c);
            if (result != -1) {
                validShot = true;
                cout << "Комп'ютер стріляє в " << COL_NAMES[c] << r + 1 << " - ";
                if (result == 1) {
                    cout << "ВЛУЧАННЯ!\n";
                    if (smartAI) {
                        if (r > 0) aiTargetStack.push({r - 1, c});
                        if (r < BOARD_SIZE - 1) aiTargetStack.push({r + 1, c});
                        if (c > 0) aiTargetStack.push({r, c - 1});
                        if (c < BOARD_SIZE - 1) aiTargetStack.push({r, c + 1});
                    }
                } else {
                    cout << "ПРОМАХ!\n";
                }
            }
        }
    }

public:
    bool start() {
        mySrand((unsigned int)time(0));
        while (true) {
            player1 = Board();
            player2 = Board();
            aiTargetStack.clear();

            cout << "=== МОРСЬКИЙ БІЙ ===\n";
            cout << "1. Гравець проти Комп'ютера\n";
            cout << "2. Комп'ютер проти Комп'ютера\n";
            cout << "0. Вихід\n";
            cout << "Виберіть режим: ";
            int mode;
            cin >> mode;

            if (mode == 0) return false;
            isCvC = (mode == 2);

            cout << "Режим комп'ютера (1 - Випадковий, 2 - Інтелектуальний): ";
            int aiMode;
            cin >> aiMode;
            smartAI = (aiMode == 2);

            if (!isCvC) {
                cout << "Розстановка ваших кораблів (1 - Вручну, 2 - Автоматично): ";
                int placeMode;
                cin >> placeMode;
                if (placeMode == 1) player1.manualPlace();
                else player1.autoPlace();
            } else {
                player1.autoPlace();
            }
            player2.autoPlace();

            if (!playLoop()) return false;
        }
    }

    bool playLoop() {
        bool p1Turn = true;

        while (true) {
            cout << "\n==================================\n";
            if (!isCvC) {
                cout << "ВАШЕ ПОЛЕ:\n";
                player1.print(false);
                cout << "\nПОЛЕ КОМП'ЮТЕРА:\n";
                player2.print(true);
            } else {
                cout << "ПОЛЕ КОМП'ЮТЕРА 1:\n";
                player1.print(false);
                cout << "\nПОЛЕ КОМП'ЮТЕРА 2:\n";
                player2.print(false);
            }

            if (player1.shipsAlive == 0) {
                cout << "\nПЕРЕМІГ КОМП'ЮТЕР 2!\n";
                return true;
            }
            if (player2.shipsAlive == 0) {
                if (isCvC) cout << "\nПЕРЕМІГ КОМП'ЮТЕР 1!\n";
                else cout << "\nВИ ПЕРЕМОГЛИ!\n";
                return true;
            }

            if (p1Turn) {
                if (isCvC) {
                    cout << "\nХід Комп'ютера 1... (Введіть P для паузи, або будь-яку іншу літеру для продовження): ";
                    char cmd[10];
                    cin >> cmd;
                    if (myToupper(cmd[0]) == 'P' || cmd[0] == 'П' || cmd[0] == 'п') {
                        int m = handleMenu();
                        if (m == 2) return true;
                        if (m == 3) return false;
                    }
                    aiTurn(player2);
                } else {
                    cout << "\nВаш хід! Введіть координати (напр. Б5) або P для паузи/меню: ";
                    char input[20];
                    cin >> input;
                    if (myToupper(input[0]) == 'P' || (unsigned char)input[0] == 0xD0 || (unsigned char)input[0] == 0xD1) {
                        if (myToupper(input[0]) == 'P' || ((unsigned char)input[0] == 0xD0 && ((unsigned char)input[1] == 0x9F || (unsigned char)input[1] == 0xBF))) {
                            int m = handleMenu();
                            if (m == 2) return true;
                            if (m == 3) return false;
                            continue;
                        }
                    }

                    int r, c;
                    if (Board::parseCoord(input, r, c)) {
                        int res = player2.receiveShot(r, c);
                        if (res == -1) {
                            cout << "Ви вже стріляли сюди! Спробуйте ще.\n";
                            continue;
                        }
                        if (res == 1) cout << ">>> ВИ ВЛУЧИЛИ!\n";
                        else cout << ">>> ПРОМАХ.\n";
                    } else {
                        cout << "Некоректні координати!\n";
                        continue;
                    }
                }
            } else {
                cout << "\nХід комп'ютера...\n";
                aiTurn(player1);
            }

            p1Turn = !p1Turn;
        }
    }
};

